NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the CV PDF after you upload it to the assets bucket.
# Example: https://YOUR_PROJECT.supabase.co/storage/v1/object/public/assets/cv.pdf
NEXT_PUBLIC_CV_URL=

# Optional portrait in the same bucket.
NEXT_PUBLIC_PHOTO_URL=

# Cloudflare Turnstile. Both are free. Leave blank in local dev to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional email notifications. The form still stores messages when this is off.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO_EMAIL=aminemzou49@gmail.com
